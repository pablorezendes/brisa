# Copie apenas estas chaves para o .env do servidor. Nunca versione valores reais.
#
# Credenciais são globais neste release: habilite a integração em somente uma
# conta bancária por vez, exatamente a conta autorizada no aplicativo do Sicoob.
APP_PUBLIC_URL=https://brisa.tescod.com
SICOOB_AMBIENTE=producao
SICOOB_API_BASE_URL=https://api.sicoob.com.br/cobranca-bancaria/v3
SICOOB_TOKEN_URL=https://auth.sicoob.com.br/auth/realms/cooperado/protocol/openid-connect/token
SICOOB_CLIENT_ID=
# O Sicoob usa client_id + certificado neste perfil. Preencha segredo e altere
# o modo somente se o aplicativo liberado pelo banco exigir esses campos.
SICOOB_CLIENT_SECRET=
SICOOB_TOKEN_AUTH=body
# Somente sandbox: o token estático do portal permite testar sem OAuth/mTLS.
# Se optar por OAuth no sandbox, deixe vazio e configure certificado + token URL.
# Em produção, obrigatoriamente deixe vazio.
SICOOB_ACCESS_TOKEN=
# Escopos confirmados no layout Widesys. Mantenha este padrão para evitar
# invalid_scope. Webhook é opcional e só deve ser acrescentado após o Portal
# Sicoob autorizar, em conjunto: webhooks_inclusao, webhooks_consulta e
# webhooks_alteracao.
SICOOB_SCOPES="boletos_inclusao boletos_consulta boletos_alteracao"
SICOOB_TIMEOUT_MS=15000
# Produção OAuth: envie o PFX para auth/sicoob/client.pfx no host e use o
# caminho interno abaixo. Preencha a senha somente no .env privado do servidor.
# O app recusa o PFX sem senha; no sandbox com token estático, deixe ambos vazios.
SICOOB_PFX_PATH=/run/secrets/sicoob/client.pfx
SICOOB_PFX_PASSPHRASE=
# Alternativa ao PFX: certificado e chave PEM. Não use as duas formas juntas.
SICOOB_CERT_PATH=
SICOOB_KEY_PATH=
SICOOB_CERT_PASSPHRASE=
# Ambos aceitam somente Base64URL/hex forte, com 43 a 128 caracteres.
# `openssl rand -hex 32` gera um valor válido de 64 caracteres; use um valor
# diferente para cada segredo.
# O webhook tipo 7 é opcional. Deixe vazio enquanto os três escopos webhooks_*
# não estiverem explicitamente autorizados e presentes em SICOOB_SCOPES.
SICOOB_WEBHOOK_SECRET=
SICOOB_SYNC_SECRET=
SICOOB_WEBHOOK_EMAIL=
