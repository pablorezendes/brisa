// Schema conforme gestao-imoveis-brisa/references/06-schema-dados.md.
// Decisões de adaptação para SQLite:
//  - Valores monetários SEMPRE em centavos (Int). Nunca float.
//  - Competências/meses como String "YYYY-MM" e datas como String "YYYY-MM-DD"
//    (evita deslocamento de fuso em datas sem hora; portável p/ PostgreSQL).
//  - Enums como String (SQLite não suporta enum no Prisma).
//  - Insumos persistidos; total/base/comissão são derivados em código
//    (src/lib/dominio/comissao.ts — única fonte da regra).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Autenticação ----------

model Usuario {
  id                         String                  @id @default(uuid())
  nome                       String
  usuario                    String                  @unique // login
  senhaHash                  String // scrypt: salt:hash (hex)
  perfil                     String                  @default("ADMINISTRADOR") // ADMINISTRADOR|FINANCEIRO|OPERADOR|CONSULTA
  criadoEm                   DateTime                @default(now())
  contasBancariasAtualizadas ContaBancaria[]         @relation("ContaBancariaAtualizadaPor")
  boletosCriados             Boleto[]                @relation("BoletoCriadoPor")
  pagamentosRegistrados      PagamentoRecebimento[]  @relation("PagamentoRegistradoPor")
  sincronizacoesIniciadas    SincronizacaoBancaria[] @relation("SincronizacaoIniciadaPor")
}

// ---------- Núcleo de locação ----------

model Empreendimento {
  id           String        @id @default(uuid())
  nome         String        @unique // normalizado (upper, sem acento)
  ativo        Boolean       @default(true)
  unidades     Unidade[]
  recebimentos Recebimento[]
}

model Locatario {
  id                  String     @id @default(uuid())
  pessoaId            String?    @unique
  nome                String
  nomeNorm            String // chave de matching (upper, sem acento, espaços colapsados)
  cpfCnpj             String? // só dígitos
  contato             String? // campo legado; mantido por compatibilidade
  email               String?
  telefone            String?
  cep                 String? // só dígitos
  endereco            String?
  numeroEndereco      String?
  complementoEndereco String?
  bairro              String?
  cidade              String?
  uf                  String? // sigla com 2 caracteres
  pessoa              Pessoa?    @relation(fields: [pessoaId], references: [id], onDelete: SetNull)
  contratos           Contrato[]
  boletos             Boleto[]

  @@index([nomeNorm])
}

// ---------- Cadastros mestres importados do Widesys ----------

// A identidade externa é sempre origem + legadoId. nome/nomeNorm servem para
// busca, nunca para deduplicação ou vínculo automático.
model Pessoa {
  id                      String                     @id @default(uuid())
  origem                  String                     @default("WIDESYS")
  legadoId                String
  tipoPessoa              String                     @default("DESCONHECIDA") // FISICA|JURIDICA|DESCONHECIDA
  tipoCadastroOrigem      String?
  categoriaOrigem         String?
  nome                    String
  nomeNorm                String
  nomeFantasia            String?
  apelido                 String?
  cpfCnpj                 String?
  rgIe                    String?
  inscricaoMunicipal      String?
  nascimentoAbertura      String?
  sexo                    String?
  estadoCivil             String?
  nacionalidade           String?
  naturalidade            String?
  profissao               String?
  nomeMae                 String?
  nomePai                 String?
  website                 String?
  recados                 String?
  observacoes             String?
  ativo                   Boolean                    @default(true)
  cep                     String?
  endereco                String?
  numeroEndereco          String?
  complementoEndereco     String?
  bairro                  String?
  cidade                  String?
  uf                      String?
  criadoPorOrigem         String?
  origemCriadoEm          String?
  origemAtualizadoEm      String?
  capturadoEm             DateTime?
  snapshot                String // JSON canônico normalizado + hashes de proveniência; sem resposta bruta
  snapshotHash            String
  importadoEm             DateTime                   @default(now())
  atualizadoEm            DateTime                   @updatedAt
  papeis                  PessoaPapel[]
  emails                  PessoaEmail[]
  telefones               PessoaTelefone[]
  locatario               Locatario?
  imoveisComoProprietario ImovelProprietarioLegado[]

  @@unique([origem, legadoId])
  @@index([nomeNorm])
  @@index([cpfCnpj])
  @@index([atualizadoEm])
}

model PessoaPapel {
  id           String   @id @default(uuid())
  pessoaId     String
  papel        String // PROPRIETARIO|INQUILINO|FIADOR|CORRETOR|FORNECEDOR|PRECADASTRO|...
  origem       String   @default("WIDESYS")
  legadoId     String // ID da pessoa na origem; papel completa a identidade desta linha
  snapshot     String // JSON canônico somente da classificação de papel
  snapshotHash String
  importadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  pessoa       Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([origem, legadoId, papel])
  @@unique([pessoaId, papel])
  @@index([papel])
}

model PessoaEmail {
  id           String   @id @default(uuid())
  pessoaId     String
  origem       String   @default("WIDESYS")
  legadoId     String // ID da pessoa na origem; emailNorm completa a identidade
  ordem        Int      @default(0)
  email        String
  emailNorm    String
  principal    Boolean  @default(false)
  snapshot     String // JSON canônico apenas do contato de origem
  snapshotHash String
  importadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  pessoa       Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([origem, legadoId, emailNorm])
  @@unique([pessoaId, emailNorm])
  @@index([emailNorm])
}

model PessoaTelefone {
  id           String   @id @default(uuid())
  pessoaId     String
  origem       String   @default("WIDESYS")
  legadoId     String // ID da pessoa na origem; telefoneNorm completa a identidade
  ordem        Int      @default(0)
  telefone     String
  telefoneNorm String
  principal    Boolean  @default(false)
  snapshot     String // JSON canônico apenas do contato de origem
  snapshotHash String
  importadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  pessoa       Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

  @@unique([origem, legadoId, telefoneNorm])
  @@unique([pessoaId, telefoneNorm])
  @@index([telefoneNorm])
}

model ImovelLegado {
  id                     String                     @id @default(uuid())
  origem                 String                     @default("WIDESYS")
  legadoId               String
  referencia             String?
  nome                   String?
  nomeNorm               String?
  apelido                String?
  tipo                   String?
  categoria              String?
  finalidade             String?
  statusComercial        String?
  publicado              Boolean                    @default(false)
  disponivel             Boolean?
  empreendimentoLegadoId String?
  empreendimentoNome     String?
  cep                    String?
  endereco               String?
  numeroEndereco         String?
  complementoEndereco    String?
  bairro                 String?
  cidade                 String?
  uf                     String?
  valorLocacao           Int?
  valorVenda             Int?
  valorCondominio        Int?
  valorIptu              Int?
  quartos                Int?
  suites                 Int?
  banheiros              Int?
  garagens               Int?
  areaTotal              String?
  latitude               String?
  longitude              String?
  descricao              String?
  observacoes            String?
  origemCriadoEm         String?
  origemAtualizadoEm     String?
  capturadoEm            DateTime?
  snapshot               String // JSON canônico normalizado + hashes de proveniência; sem resposta bruta
  snapshotHash           String
  importadoEm            DateTime                   @default(now())
  atualizadoEm           DateTime                   @updatedAt
  proprietarios          ImovelProprietarioLegado[]

  @@unique([origem, legadoId])
  @@index([referencia])
  @@index([nomeNorm])
  @@index([statusComercial, publicado])
  @@index([finalidade])
}

model ImovelProprietarioLegado {
  id                   String       @id @default(uuid())
  imovelId             String
  pessoaId             String?
  origem               String       @default("WIDESYS")
  legadoId             String // ID do vínculo proprietário-produto no Widesys
  proprietarioLegadoId String
  porcentagem          String?
  contaLegadoId        String?
  principal            Boolean      @default(false)
  ordem                Int          @default(0)
  snapshot             String // JSON canônico somente do vínculo
  snapshotHash         String
  importadoEm          DateTime     @default(now())
  atualizadoEm         DateTime     @updatedAt
  imovel               ImovelLegado @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  pessoa               Pessoa?      @relation(fields: [pessoaId], references: [id], onDelete: SetNull)

  @@unique([origem, legadoId])
  @@unique([imovelId, proprietarioLegadoId])
  @@index([pessoaId])
}

// ---------- Staging auditável da operação importada do Widesys ----------

// Esta camada é intencionalmente separada de Contrato, Recebimento e
// LancamentoCaixa. A promoção para a operação atual só pode acontecer depois
// de reconciliação explícita; nomes nunca são usados como chave de vínculo.
model ImportacaoLegadoLote {
  id              String                 @id @default(uuid())
  origem          String
  capturaId       String
  esquemaVersao   Int                    @default(1)
  manifestoHash   String
  capturadoEm     DateTime
  status          String                 @default("PROCESSANDO") // PROCESSANDO|CONCLUIDO|FALHOU|QUARENTENA
  totalEsperado   Int                    @default(0)
  totalProcessado Int                    @default(0)
  totalQuarentena Int                    @default(0)
  resumo          String                 @default("{}") // JSON sem PII: contagens, somas e checkpoints
  erroCodigo      String?
  iniciadoEm      DateTime               @default(now())
  concluidoEm     DateTime?
  atualizadoEm    DateTime               @updatedAt
  itens           ImportacaoLegadoItem[]

  @@unique([origem, capturaId])
  @@index([status, capturadoEm])
}

model ImportacaoLegadoItem {
  id                 String                     @id @default(uuid())
  loteId             String
  origem             String
  escopo             String // CONTRATO|CONTRATO_PARTE|TITULO_RECEBER|TITULO_PAGAR|BAIXA_RECEBER|BAIXA_PAGAR|MOVIMENTO
  legadoId           String
  snapshotHash       String
  acao               String // CRIAR|ATUALIZAR|INALTERADO|QUARENTENA|MARCAR_AUSENTE
  status             String                     @default("CONCLUIDO") // CONCLUIDO|QUARENTENA
  quarentenaMotivo   String?
  processadoEm       DateTime                   @default(now())
  lote               ImportacaoLegadoLote       @relation(fields: [loteId], references: [id], onDelete: Cascade)
  contratoAtual      ContratoLegado?            @relation("ContratoLegadoUltimoItem")
  contratoParteAtual ContratoParteLegado?       @relation("ContratoParteLegadoUltimoItem")
  tituloAtual        TituloFinanceiroLegado?    @relation("TituloLegadoUltimoItem")
  baixaAtual         BaixaFinanceiraLegado?     @relation("BaixaLegadoUltimoItem")
  movimentoAtual     MovimentoFinanceiroLegado? @relation("MovimentoLegadoUltimoItem")

  @@unique([loteId, escopo, legadoId])
  @@index([origem, escopo, legadoId])
  @@index([status, escopo])
}

model ContratoLegado {
  id                 String                @id @default(uuid())
  origem             String                @default("WIDESYS")
  legadoId           String
  ultimoItemId       String                @unique
  numeroContrato     String?
  imovelLegadoId     String?
  situacaoOrigem     String?
  inicio             String?
  fim                String?
  primeiroVencimento String?
  proximoReajuste    String?
  valorLocacao       Int?
  valorAdministracao Int?
  valorCaucao        Int?
  statusImportacao   String                @default("STAGING") // STAGING|QUARENTENA|RECONCILIADO|PROMOVIDO|AUSENTE_NA_FONTE
  quarentenaMotivo   String?
  sourceUrl          String?
  capturadoEm        DateTime
  snapshot           String // JSON canônico sanitizado, sem credenciais/tokens
  snapshotHash       String
  importadoEm        DateTime              @default(now())
  atualizadoEm       DateTime              @updatedAt
  ultimoItem         ImportacaoLegadoItem  @relation("ContratoLegadoUltimoItem", fields: [ultimoItemId], references: [id], onDelete: Restrict)
  partes             ContratoParteLegado[]

  @@unique([origem, legadoId])
  @@index([numeroContrato])
  @@index([imovelLegadoId])
  @@index([statusImportacao])
}

model ContratoParteLegado {
  id               String               @id @default(uuid())
  origem           String               @default("WIDESYS")
  legadoId         String
  ultimoItemId     String               @unique
  contratoId       String?
  contratoLegadoId String
  papel            String // INQUILINO|PROPRIETARIO|BENEFICIARIO|FIADOR|CORRETOR
  pessoaLegadoId   String?
  ordem            Int                  @default(0)
  percentual       String?
  valor            Int?
  statusImportacao String               @default("STAGING") // STAGING|QUARENTENA|RECONCILIADO|PROMOVIDO|AUSENTE_NA_FONTE
  quarentenaMotivo String?
  capturadoEm      DateTime
  snapshot         String
  snapshotHash     String
  importadoEm      DateTime             @default(now())
  atualizadoEm     DateTime             @updatedAt
  ultimoItem       ImportacaoLegadoItem @relation("ContratoParteLegadoUltimoItem", fields: [ultimoItemId], references: [id], onDelete: Restrict)
  contrato         ContratoLegado?      @relation(fields: [contratoId], references: [id], onDelete: SetNull)

  @@unique([origem, legadoId])
  @@index([origem, contratoLegadoId, papel, pessoaLegadoId, ordem])
  @@index([contratoLegadoId, papel])
  @@index([pessoaLegadoId])
  @@index([statusImportacao])
}

model TituloFinanceiroLegado {
  id                     String               @id @default(uuid())
  origem                 String               @default("WIDESYS")
  escopo                 String // TITULO_RECEBER|TITULO_PAGAR
  legadoId               String
  ultimoItemId           String               @unique
  natureza               String // RECEBER|PAGAR
  numeroDocumento        String?
  parcela                String?
  contratoLegadoId       String?
  pessoaLegadoId         String?
  contrapartePapelOrigem String?
  contaBancariaLegadoId  String?
  contaBancariaRotulo    String?
  planoContaLegadoId     String?
  planoContaRotulo       String?
  tipoCobrancaLegadoId   String?
  tipoCobrancaRotulo     String?
  emissao                String?
  competencia            String?
  vencimento             String?
  pagamento              String?
  valorOriginal          Int?
  valorDevido            Int? // valor bruto devido na origem; não é o saldo
  valorAberto            Int?
  valorPago              Int?
  juros                  Int?
  multa                  Int?
  desconto               Int?
  situacaoOrigem         String?
  situacaoNormalizada    String // PENDENTE|VENCIDO|PARCIAL|PAGO|CANCELADO|DESCONHECIDO
  pagamentoParcial       Boolean              @default(false)
  inadimplente           Boolean              @default(false)
  statusImportacao       String               @default("STAGING") // STAGING|QUARENTENA|RECONCILIADO|PROMOVIDO|AUSENTE_NA_FONTE
  quarentenaMotivo       String?
  sourceUrl              String?
  capturadoEm            DateTime
  snapshot               String
  snapshotHash           String
  importadoEm            DateTime             @default(now())
  atualizadoEm           DateTime             @updatedAt
  ultimoItem             ImportacaoLegadoItem @relation("TituloLegadoUltimoItem", fields: [ultimoItemId], references: [id], onDelete: Restrict)

  @@unique([origem, escopo, legadoId])
  @@index([natureza, situacaoNormalizada, vencimento])
  @@index([contratoLegadoId])
  @@index([pessoaLegadoId])
  @@index([inadimplente, vencimento])
  @@index([statusImportacao])
}

model MovimentoFinanceiroLegado {
  id                    String               @id @default(uuid())
  origem                String               @default("WIDESYS")
  escopo                String               @default("MOVIMENTO")
  legadoId              String
  ultimoItemId          String               @unique
  natureza              String // ENTRADA|SAIDA|TRANSFERENCIA|DESCONHECIDA
  tituloEscopo          String?
  tituloLegadoId        String?
  contaBancariaLegadoId String?
  contaBancariaRotulo   String?
  planoContaLegadoId    String?
  planoContaRotulo      String?
  documento             String?
  descricao             String?
  dataMovimento         String?
  competencia           String?
  valor                 Int?
  conciliado            Boolean?
  situacaoOrigem        String?
  statusImportacao      String               @default("STAGING") // STAGING|QUARENTENA|RECONCILIADO|PROMOVIDO|AUSENTE_NA_FONTE
  quarentenaMotivo      String?
  sourceUrl             String?
  capturadoEm           DateTime
  snapshot              String
  snapshotHash          String
  importadoEm           DateTime             @default(now())
  atualizadoEm          DateTime             @updatedAt
  ultimoItem            ImportacaoLegadoItem @relation("MovimentoLegadoUltimoItem", fields: [ultimoItemId], references: [id], onDelete: Restrict)

  @@unique([origem, escopo, legadoId])
  @@index([dataMovimento, natureza])
  @@index([tituloEscopo, tituloLegadoId])
  @@index([contaBancariaLegadoId])
  @@index([statusImportacao])
}

model BaixaFinanceiraLegado {
  id                    String               @id @default(uuid())
  origem                String               @default("WIDESYS")
  escopo                String // BAIXA_RECEBER|BAIXA_PAGAR
  legadoId              String
  ultimoItemId          String               @unique
  natureza              String // RECEBIMENTO|PAGAMENTO
  tituloEscopo          String
  tituloLegadoId        String
  movimentoLegadoId     String? // Nº Lanç.; referência flexível até a reconciliação completa do caixa
  contaBancariaLegadoId String?
  contaBancariaRotulo   String?
  numeroDocumento       String?
  forma                 String?
  dataPagamento         String?
  valor                 Int?
  responsavelOrigem     String?
  origemRegistradoEm    String?
  situacaoOrigem        String?
  estornada             Boolean              @default(false)
  statusImportacao      String               @default("STAGING") // STAGING|QUARENTENA|RECONCILIADO|PROMOVIDO|AUSENTE_NA_FONTE
  quarentenaMotivo      String?
  sourceUrl             String?
  capturadoEm           DateTime
  snapshot              String
  snapshotHash          String
  importadoEm           DateTime             @default(now())
  atualizadoEm          DateTime             @updatedAt
  ultimoItem            ImportacaoLegadoItem @relation("BaixaLegadoUltimoItem", fields: [ultimoItemId], references: [id], onDelete: Restrict)

  @@unique([origem, escopo, legadoId])
  @@index([tituloEscopo, tituloLegadoId])
  @@index([movimentoLegadoId])
  @@index([dataPagamento, natureza])
  @@index([statusImportacao])
}

model Unidade {
  id               String             @id @default(uuid())
  empreendimentoId String
  identificacao    String // "PIO XII SALA 01"
  tipo             String             @default("residencial") // residencial|comercial|temporada
  ativo            Boolean            @default(true)
  empreendimento   Empreendimento     @relation(fields: [empreendimentoId], references: [id])
  contratos        Contrato[]
  unidadeTemporada UnidadeTemporada[]

  @@unique([empreendimentoId, identificacao])
}

model Contrato {
  id             String        @id @default(uuid())
  unidadeId      String
  locatarioId    String? // NULL = desocupado
  valorBase      Int           @default(0) // centavos
  iptu           Int           @default(0)
  condominio     Int           @default(0)
  diaVencimento  Int?
  mesReajuste    Int? // 1..12
  indiceReajuste String? // IGPM|IPCA (não consta na origem)
  status         String        @default("ativo") // ativo|encerrado|acordo
  inicio         String? // "YYYY-MM-DD"
  fim            String?
  observacao     String?
  unidade        Unidade       @relation(fields: [unidadeId], references: [id])
  locatario      Locatario?    @relation(fields: [locatarioId], references: [id])
  recebimentos   Recebimento[]

  @@index([unidadeId])
}

model ParametroComissao {
  id       String @id @default(uuid())
  vigencia String @unique // "YYYY-MM" (início da vigência)
  taxaBps  Int    @default(1000) // 1000 = 10%
}

model Recebimento {
  id                  String                 @id @default(uuid())
  contratoId          String
  empreendimentoId    String // denormalizado p/ relatório de comissão
  mesLancamento       String // "YYYY-MM" — mês da aba RECEB (dimensão da matriz COMISSÃO e do fechamento)
  competencia         String // "YYYY-MM" (mês de referência; pode diferir do lançamento — atrasos/adiantamentos)
  valor               Int                    @default(0) // insumos em centavos
  iptu                Int                    @default(0)
  cond                Int                    @default(0)
  recebido            Int? // NULL = não recebido
  dataPagamento       String? // "YYYY-MM-DD"
  via                 String? // BOLETO|PIX|DINHEIRO
  taxaComissaoBps     Int                    @default(1000) // snapshot da taxa do mês
  observacao          String?
  origemAgregada      Boolean                @default(false) // true na linha AIRBNB/TODOS
  reservaEmissaoToken String? // lease transacional enquanto nasce o primeiro registro de boleto
  contrato            Contrato               @relation(fields: [contratoId], references: [id])
  empreendimento      Empreendimento         @relation(fields: [empreendimentoId], references: [id])
  boletos             Boleto[]
  pagamentos          PagamentoRecebimento[]

  @@index([mesLancamento, empreendimentoId])
  @@index([competencia])
  @@index([contratoId])
}

// ---------- Bancos, cobrança e conciliação ----------

// Credenciais, tokens e certificados não pertencem ao banco de dados. Eles são
// fornecidos ao servidor por variáveis de ambiente/arquivos de segredo.
model ContaBancaria {
  id                          String                      @id @default(uuid())
  codigoBanco                 String // código COMPE; 756 = Bancoob/Sicoob
  nomeBanco                   String
  agencia                     String // texto para preservar zeros e dígito
  numero                      String // texto para preservar zeros e dígito
  apelido                     String
  finalidade                  String? // OPERACIONAL|APLICACAO|IPTU|OUTRA
  ativa                       Boolean                     @default(true)
  padrao                      Boolean                     @default(false)
  integracaoHabilitada        Boolean                     @default(false)
  boletosHabilitados          Boolean                     @default(false)
  integracaoStatus            String                      @default("NAO_CONFIGURADA") // NAO_CONFIGURADA|PRONTA|ERRO
  ambiente                    String                      @default("SANDBOX") // SANDBOX|PRODUCAO
  numeroCliente               String?
  codigoModalidade            Int?
  numeroContaCorrenteApi      String? // sem dígito; confirmado no convênio, nunca inferido da tela legada
  codigoEspecieDocumento      String? // RC|DS|DM... conforme contrato; nunca inferido pela aplicação
  numeroContratoCobranca      String?
  webhookId                   String?
  webhookStatus               String? // AGUARDANDO_VALIDACAO|VALIDADO|INATIVO|ERRO
  liquidacoesSincronizadasAte String? // último dia civil concluído; a próxima janela o sobrepõe por segurança
  liquidacoesReprocessarDesde String? // cursor durável para refazer janelas antigas/sem conteúdo sem recuar o avanço principal
  ultimaSincronizacaoEm       DateTime?
  mensagemIntegracao          String?
  atualizadoPorUsuarioId      String?
  criadoEm                    DateTime                    @default(now())
  atualizadoEm                DateTime                    @updatedAt
  atualizadoPor               Usuario?                    @relation("ContaBancariaAtualizadaPor", fields: [atualizadoPorUsuarioId], references: [id], onDelete: SetNull)
  boletos                     Boleto[]
  pagamentos                  PagamentoRecebimento[]
  sincronizacoes              SincronizacaoBancaria[]
  configuracaoCobrancaSicoob  ConfiguracaoCobrancaSicoob?

  @@unique([codigoBanco, agencia, numero])
  @@index([ativa, padrao])
}

// Parâmetros operacionais não secretos capturados do layout de cobrança
// legado. Client ID, certificado PFX e senha continuam exclusivamente no
// cofre/ambiente do servidor e nunca devem ser persistidos neste modelo.
model ConfiguracaoCobrancaSicoob {
  id                       String        @id @default(uuid())
  contaBancariaId          String        @unique
  layoutLegadoId           Int?
  nomeLayoutLegado         String?
  contaLiquidacaoLegadoId  Int?
  bancoLegadoId            Int?
  ativaLegado              Boolean?
  padraoLegado             Boolean?
  sistemaOrigem            String        @default("WIDESYS")
  capturadoEm              DateTime
  agenciaRemessa           String
  numeroContaPixLegado     String?
  numeroContaRemessaLegado String?
  numeroContaCorrenteApi   String
  carteiraLegada           String
  convenioLegado           String?
  modalidadeCobrancaLegada String?
  numeroCliente            String
  codigoEspecieDocumento   String
  aceite                   String        @default("N")
  moeda                    String        @default("R$")
  protestoAutomaticoLegado String?
  diasProtesto             Int           @default(0)
  ultimoNossoNumeroLegado  Int?
  loteLegado               Int?
  escopos                  String
  toleranciaPagamentoDias  Int           @default(0)
  protestoEmDiasUteis      Boolean       @default(false)
  correspondente           String        @default("API")
  bancoNumera              Boolean       @default(false)
  bancoEmite               Boolean?
  bancoDespacha            Boolean?
  mensagens                String        @default("[]") // JSON; [] representa os quatro campos legados vazios
  exibirServicos           Boolean       @default(false)
  usoAutorizado            Boolean       @default(false)
  mostrarIptu              Boolean       @default(false)
  avisoDeposito            Boolean       @default(false)
  lancarTarifa             Boolean       @default(false)
  planoContaLegadoId       Int? // referência de auditoria; não é FK para o plano atual
  criadoEm                 DateTime      @default(now())
  atualizadoEm             DateTime      @updatedAt
  contaBancaria            ContaBancaria @relation(fields: [contaBancariaId], references: [id], onDelete: Cascade)
}

// O webhook pertence ao aplicativo/credencial Sicoob, não a uma conta isolada.
// A impressão digital identifica o client_id sem persistir qualquer segredo.
model PerfilIntegracaoSicoob {
  id                    String   @id @default(uuid())
  ambiente              String
  credencialFingerprint String
  webhookId             String?
  webhookStatus         String?
  webhookUrlHash        String?
  criadoEm              DateTime @default(now())
  atualizadoEm          DateTime @updatedAt

  @@unique([ambiente, credencialFingerprint])
  @@unique([ambiente, webhookId])
}

// Um recebimento pode ter mais de um boleto ao longo do tempo (por exemplo,
// baixa e reemissão). A aplicação impede dois títulos ativos simultâneos.
model Boleto {
  id                    String                 @id @default(uuid())
  contaBancariaId       String
  recebimentoId         String
  locatarioId           String?
  criadoPorUsuarioId    String?
  chaveIdempotencia     String                 @unique
  slotRecebimentoAtivo  String?                @unique // recebimentoId enquanto o título ainda bloqueia nova emissão
  seuNumero             String                 @unique
  nossoNumero           String?
  ambienteBanco         String // snapshot: SANDBOX|PRODUCAO
  numeroClienteBanco    Int
  numeroContaBanco      Int
  codigoModalidadeBanco Int
  contratoCobrancaBanco Int?
  especieDocumentoBanco String
  respostaCodigo        String? // código de correlação devolvido pela API
  status                String                 @default("RASCUNHO") // RASCUNHO|EMITINDO|RESULTADO_DESCONHECIDO|REGISTRADO|VENCIDO|PAGAMENTO_REPORTADO|CANCELAMENTO_REPORTADO|LIQUIDADO|BAIXADO_SEM_PAGAMENTO|ESTORNADO|ERRO
  situacaoBanco         String?
  conciliacaoStatus     String                 @default("PENDENTE") // PENDENTE|CONCILIADO|DIVERGENTE|IGNORADO
  conciliacaoMotivo     String? // código estruturado; não usar mensagem humana como estado de máquina
  valor                 Int // centavos; valor enviado no registro
  valorPago             Int? // centavos; informado pelo banco
  dataVencimento        String // "YYYY-MM-DD"
  linhaDigitavel        String?
  codigoBarras          String?
  qrCode                String?
  pagadorNome           String
  pagadorCpfCnpj        String // só dígitos; snapshot imutável
  pagadorEmail          String?
  pagadorTelefone       String?
  pagadorCep            String?
  pagadorEndereco       String?
  pagadorNumeroEndereco String?
  pagadorComplemento    String?
  pagadorBairro         String?
  pagadorCidade         String?
  pagadorUf             String?
  emitidoEm             DateTime?
  ultimaConsultaEm      DateTime?
  liquidadoEm           DateTime?
  mensagemErro          String?
  tentativas            Int                    @default(0)
  criadoEm              DateTime               @default(now())
  atualizadoEm          DateTime               @updatedAt
  contaBancaria         ContaBancaria          @relation(fields: [contaBancariaId], references: [id])
  recebimento           Recebimento            @relation(fields: [recebimentoId], references: [id])
  locatario             Locatario?             @relation(fields: [locatarioId], references: [id], onDelete: SetNull)
  criadoPor             Usuario?               @relation("BoletoCriadoPor", fields: [criadoPorUsuarioId], references: [id], onDelete: SetNull)
  eventos               EventoBoleto[]
  pagamentos            PagamentoRecebimento[]

  @@unique([contaBancariaId, nossoNumero])
  @@index([recebimentoId, status])
  @@index([contaBancariaId, status])
  @@index([conciliacaoStatus])
}

// Guarda somente metadados necessários à idempotência/auditoria. O corpo bruto
// do webhook pode conter dados pessoais e não deve ser persistido neste modelo.
model EventoBoleto {
  id                  String                 @id @default(uuid())
  boletoId            String?
  sincronizacaoId     String?
  chaveEvento         String                 @unique
  origem              String // WEBHOOK|CONSULTA|MOVIMENTACAO|EMISSAO
  tipo                String
  nossoNumero         String?
  seuNumero           String?
  situacaoBanco       String?
  payloadHash         String
  statusProcessamento String                 @default("PENDENTE") // PENDENTE|PROCESSADO|IGNORADO|ERRO
  recebidoEm          DateTime               @default(now())
  processadoEm        DateTime?
  erro                String?
  boleto              Boleto?                @relation(fields: [boletoId], references: [id], onDelete: SetNull)
  sincronizacao       SincronizacaoBancaria? @relation(fields: [sincronizacaoId], references: [id], onDelete: SetNull)
  pagamento           PagamentoRecebimento?

  @@index([boletoId, recebidoEm])
  @@index([statusProcessamento, recebidoEm])
  @@index([nossoNumero])
}

// Trilha financeira normalizada. Os campos recebido/dataPagamento/via de
// Recebimento continuam existindo durante a transição e são atualizados pela
// conciliação de forma transacional.
model PagamentoRecebimento {
  id                     String         @id @default(uuid())
  recebimentoId          String
  boletoId               String?
  eventoBoletoId         String?        @unique
  contaBancariaId        String?
  registradoPorUsuarioId String?
  identificadorBanco     String?        @unique
  chaveIdempotencia      String         @unique
  valor                  Int // centavos
  dataPagamento          String // "YYYY-MM-DD"
  dataCredito            String? // "YYYY-MM-DD"
  forma                  String         @default("BOLETO") // BOLETO|PIX|DINHEIRO|TRANSFERENCIA|OUTRO
  origem                 String         @default("SICOOB") // SICOOB|MANUAL|LEGADO
  status                 String         @default("CONFIRMADO") // PENDENTE|CONFIRMADO|ESTORNADO
  conciliadoEm           DateTime?
  motivoPendencia        String?
  criadoEm               DateTime       @default(now())
  atualizadoEm           DateTime       @updatedAt
  recebimento            Recebimento    @relation(fields: [recebimentoId], references: [id])
  boleto                 Boleto?        @relation(fields: [boletoId], references: [id], onDelete: SetNull)
  eventoBoleto           EventoBoleto?  @relation(fields: [eventoBoletoId], references: [id], onDelete: SetNull)
  contaBancaria          ContaBancaria? @relation(fields: [contaBancariaId], references: [id], onDelete: SetNull)
  registradoPor          Usuario?       @relation("PagamentoRegistradoPor", fields: [registradoPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([recebimentoId, dataPagamento])
  @@index([boletoId])
  @@index([status, dataPagamento])
}

model SincronizacaoBancaria {
  id                    String         @id @default(uuid())
  contaBancariaId       String
  iniciadoPorUsuarioId  String?
  tipo                  String // BOLETOS|MOVIMENTACOES|WEBHOOK
  status                String         @default("PENDENTE") // PENDENTE|EM_ANDAMENTO|CONCLUIDA|ERRO
  janelaInicio          String? // "YYYY-MM-DD"
  janelaFim             String? // "YYYY-MM-DD"
  cursor                String?
  slotExecucao          String?        @unique // reserva enquanto a mesma conta/tipo está em processamento
  lockToken             String? // lease curto: impede duas invocações de processarem o mesmo cursor
  lockExpiraEm          DateTime?
  quantidadeLidos       Int            @default(0)
  quantidadeProcessados Int            @default(0)
  quantidadeErros       Int            @default(0)
  mensagemErro          String?
  iniciadaEm            DateTime       @default(now())
  concluidaEm           DateTime?
  contaBancaria         ContaBancaria  @relation(fields: [contaBancariaId], references: [id])
  iniciadoPor           Usuario?       @relation("SincronizacaoIniciadaPor", fields: [iniciadoPorUsuarioId], references: [id], onDelete: SetNull)
  eventos               EventoBoleto[]

  @@index([contaBancariaId, iniciadaEm])
  @@index([status, iniciadaEm])
}

model FechamentoMensal {
  id            String   @id @default(uuid())
  mesLancamento String   @unique // "YYYY-MM" (mês operacional fechado — mesma dimensão da matriz)
  comissaoTotal Int // centavos (snapshot imutável)
  detalhe       String // JSON: comissão por empreendimento
  fechadoEm     DateTime @default(now())
}

// ---------- Módulo Temporada (Airbnb) ----------

model UnidadeTemporada {
  id           String                 @id @default(uuid())
  codigo       String                 @unique // "208", "304"...
  unidadeId    String?
  ativo        Boolean                @default(true)
  unidade      Unidade?               @relation(fields: [unidadeId], references: [id])
  limpezas     Limpeza[]
  despesas     DespesaTemporada[]
  recebimentos RecebimentoTemporada[]
}

model Limpeza {
  id                 String           @id @default(uuid())
  unidadeTemporadaId String
  competencia        String // "YYYY-MM"
  quantidade         Int              @default(0)
  valorUnitario      Int              @default(5000) // R$50,00
  extraPdl           Int              @default(0)
  unidadeTemporada   UnidadeTemporada @relation(fields: [unidadeTemporadaId], references: [id])

  @@index([competencia])
}

model DespesaTemporada {
  id                 String            @id @default(uuid())
  unidadeTemporadaId String? // NULL = despesa do mês (extra/produto)
  competencia        String
  tipo               String // ENERGIA|CONDO|IPTU|LIMPEZA|EXTRA
  valor              Int
  unidadeTemporada   UnidadeTemporada? @relation(fields: [unidadeTemporadaId], references: [id])

  @@index([competencia])
}

model RecebimentoTemporada {
  id                 String            @id @default(uuid())
  unidadeTemporadaId String?
  competencia        String
  valor              Int
  plataforma         String?
  hospede            String?
  unidadeTemporada   UnidadeTemporada? @relation(fields: [unidadeTemporadaId], references: [id])

  @@index([competencia])
}

// Apuração histórica importada da planilha AIRBNB (anos anteriores à operação).
// 2023/2024 têm receita e despesa rotuladas; 2025 só receita (despesa = null,
// lucro indeterminado). O ano corrente é derivado do núcleo, não desta tabela.
model ApuracaoTemporadaHistorica {
  id      String @id @default(uuid())
  ano     Int
  mes     Int // 1..12
  receita Int // centavos
  despesa Int? // null = planilha não tem total de despesa rotulado no ano

  @@unique([ano, mes])
}

// ---------- Módulo Caixa (CONTA_AC) ----------

model LancamentoCaixa {
  id            String  @id @default(uuid())
  mesReferencia String // "YYYY-MM" (mês da aba)
  centroCusto   String // AL|CH|GERAL (GERAL: ENTRADA e RECEB_DINHEIRO, que na origem não têm centro)
  tipo          String // SAIDA|ENTRADA|RECEB_DINHEIRO
  categoria     String? // seção da legenda (só SAIDA)
  data          String? // "YYYY-MM-DD"
  valor         Int // centavos
  descricao     String?
  cliente       String? // só RECEB_DINHEIRO
  local         String? // só RECEB_DINHEIRO

  @@index([mesReferencia, centroCusto])
}

model CategoriaCentroCusto {
  id          String @id @default(uuid())
  centroCusto String // AL|CH
  nome        String

  @@unique([centroCusto, nome])
}

// ---------- Staging auditavel dos catalogos importados do Widesys ----------

// Catalogos permanecem isolados da operacao. Nenhum registro deste bloco e
// promovido automaticamente para contas, categorias ou configuracoes atuais.
model CatalogoLegadoCaptura {
  id              String               @id @default(uuid())
  origem          String
  capturaId       String
  manifestoHash   String
  capturadoEm     DateTime
  status          String               @default("PROCESSANDO") // PROCESSANDO|CONCLUIDO|FALHOU
  totalEsperado   Int                  @default(0)
  totalProcessado Int                  @default(0)
  totalQuarentena Int                  @default(0)
  resumo          String               @default("{}") // JSON sem valores cadastrais
  erroCodigo      String?
  iniciadoEm      DateTime             @default(now())
  concluidoEm     DateTime?
  atualizadoEm    DateTime             @updatedAt
  itens           CatalogoLegadoItem[]

  @@unique([origem, capturaId])
  @@index([status, capturadoEm])
}

model CatalogoLegadoItem {
  id               String                  @id @default(uuid())
  capturaId        String
  origem           String
  modulo           String
  legadoId         String
  snapshotHash     String
  acao             String // CRIAR|ATUALIZAR|INALTERADO|QUARENTENA|ANTERIOR_IGNORADO
  status           String                  @default("CONCLUIDO") // CONCLUIDO|QUARENTENA
  quarentenaMotivo String?
  processadoEm     DateTime                @default(now())
  captura          CatalogoLegadoCaptura   @relation(fields: [capturaId], references: [id], onDelete: Cascade)
  registroAtual    CatalogoLegadoRegistro? @relation("CatalogoLegadoUltimoItem")

  @@unique([capturaId, modulo, legadoId])
  @@index([origem, modulo, legadoId])
  @@index([status, modulo])
}

model CatalogoLegadoRegistro {
  id               String             @id @default(uuid())
  origem           String
  modulo           String
  legadoId         String
  titulo           String?
  label            String?
  sourceUrl        String?
  capturadoEm      DateTime
  status           String             @default("STAGING") // STAGING|QUARENTENA
  quarentenaMotivo String?
  snapshot         String // JSON canonico sanitizado; nunca contem credenciais
  snapshotHash     String
  importadoEm      DateTime           @default(now())
  atualizadoEm     DateTime           @updatedAt
  ultimoItemId     String             @unique
  ultimoItem       CatalogoLegadoItem @relation("CatalogoLegadoUltimoItem", fields: [ultimoItemId], references: [id], onDelete: Restrict)

  @@unique([origem, modulo, legadoId])
  @@index([modulo, status])
  @@index([capturadoEm])
}
